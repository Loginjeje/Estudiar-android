<?xml version="1.0" encoding="utf-8"?>
<!--
    Fitxa del contacte. ScrollView només admet un fill directe: tot va dins
    del LinearLayout.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/arrel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivFoto"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_monograma"
            android:contentDescription="@string/desc_foto"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_contacte" />

        <TextView
            android:id="@+id/tvNom"
            style="@style/TextTitol"
            android:layout_marginTop="12dp"
            android:gravity="center" />

        <TextView
            style="@style/TextCampEtiqueta"
            android:layout_marginTop="16dp"
            android:text="@string/lbl_email" />

        <TextView
            android:id="@+id/tvEmail"
            style="@style/TextCamp" />

        <TextView
            style="@style/TextCampEtiqueta"
            android:layout_marginTop="12dp"
            android:text="@string/lbl_telefon" />

        <TextView
            android:id="@+id/tvTelefon"
            style="@style/TextCamp" />

        <TextView
            style="@style/TextCampEtiqueta"
            android:layout_marginTop="12dp"
            android:text="@string/lbl_adreca" />

        <TextView
            android:id="@+id/tvAdreca"
            style="@style/TextCamp" />

        <TextView
            style="@style/TextCampEtiqueta"
            android:layout_marginTop="12dp"
            android:text="@string/lbl_web" />

        <TextView
            android:id="@+id/tvWeb"
            style="@style/TextCamp" />

        <CheckBox
            android:id="@+id/chkFavorit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/lbl_favorit"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnTrucar"
            style="@style/BotoContactes.Boto.Container"
            android:layout_marginTop="16dp"
            android:text="@string/btn_trucar" />

        <Button
            android:id="@+id/btnCorreu"
            style="@style/BotoContactes.Boto.Container"
            android:layout_marginTop="8dp"
            android:text="@string/btn_correu" />

        <Button
            android:id="@+id/btnMapa"
            style="@style/BotoContactes.Boto.Container"
            android:layout_marginTop="8dp"
            android:text="@string/btn_mapa" />

        <Button
            android:id="@+id/btnWeb"
            style="@style/BotoContactes.Boto.Container"
            android:layout_marginTop="8dp"
            android:text="@string/btn_web" />

        <Button
            android:id="@+id/btnAlarma"
            style="@style/BotoContactes.Boto.Container"
            android:layout_marginTop="8dp"
            android:text="@string/btn_alarma" />

        <Button
            android:id="@+id/btnGaleria"
            style="@style/BotoContactes.Boto.Container"
            android:layout_marginTop="8dp"
            android:text="@string/btn_galeria" />

    </LinearLayout>

</ScrollView>
